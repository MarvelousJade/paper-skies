--!strict
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local RS = game:GetService("ReplicatedStorage")
local package = RS:WaitForChild("PaperFlight")
local Config = require(package.Config)
local Flight = require(package.Flight)
local remote = package.RaceEvent
local template = package.Plane
local planes = Instance.new("Folder")
planes.Name = "ActivePaperPlanes"
planes.Parent = workspace
local sessions = {}
local cooldown = {}
local bests = {}
local aiming = {}
local function send(player, status, data)
 remote:FireClient(player, status, data)
end
-- Keep the avatar at the throwing spot. Only the separate projectile moves.
local function restore(player)
 aiming[player] = nil
 local character = player.Character
 if character then
  character:SetAttribute("PaperThrowPose",nil)
  local root = character:FindFirstChild("HumanoidRootPart")
  local humanoid = character:FindFirstChildOfClass("Humanoid")
  if root then root.Anchored = false end
  if humanoid then humanoid.AutoRotate = true end
 end
end
local function prepare(player)
 if sessions[player] then return end
 local character = player.Character
 local root = character and character:FindFirstChild("HumanoidRootPart")
 local humanoid = character and character:FindFirstChildOfClass("Humanoid")
 if not root or not humanoid or humanoid.Health <= 0 then return end
 if not aiming[player] then
  character:PivotTo(CFrame.new(Config.ThrowStand))
  root.Anchored = true
  humanoid.AutoRotate = false
  aiming[player] = true
  character:SetAttribute("PaperThrowPose","Aiming")
 end
 send(player,"Aiming",{origin=Config.Launch})
end
local function removeProjectile(player, session)
 if workspace.StreamingEnabled then player:RemoveReplicationFocus(session.model.PrimaryPart) end
 session.model:Destroy()
end
local function stop(player, status, message)
 local session = sessions[player]
 if not session then return end
 sessions[player] = nil
 removeProjectile(player,session)
 restore(player)
 send(player,status,{message=message, time=session.elapsed, best=bests[player.UserId]})
end
local function launch(player, yaw, pitch)
 -- The client supplies a bounded launch direction, never an origin or race result.
 if typeof(yaw)~="number" or typeof(pitch)~="number" then return end
 if yaw~=yaw or pitch~=pitch or math.abs(yaw)>Config.MaxAimYaw or math.abs(pitch)>Config.MaxPitch then return end
 local now = os.clock()
 if now - (cooldown[player] or -10) < 1 then return end
 if sessions[player] or not aiming[player] then return end
 cooldown[player] = now
 local character = player.Character
 local root = character and character:FindFirstChild("HumanoidRootPart")
 local humanoid = character and character:FindFirstChildOfClass("Humanoid")
 if not root or not humanoid or humanoid.Health <= 0 then return end
 aiming[player] = nil
 local model = template:Clone()
 model.Name = "Plane_"..player.UserId
 model:ScaleTo(0.65)
 model.ModelStreamingMode=Enum.ModelStreamingMode.Atomic
 model.Parent = planes
 local state = {position=Config.Launch,yaw=yaw,pitch=pitch}
 model:PivotTo(Flight.frame(state,0))
 if workspace.StreamingEnabled then player:AddReplicationFocus(model.PrimaryPart) end
 character:SetAttribute("PaperThrowPose","Throwing")
 local params=RaycastParams.new()
 params.FilterType=Enum.RaycastFilterType.Include
 params.FilterDescendantsInstances={workspace.PaperFlightWorld}
 sessions[player] = {raycast=params, model=model, state=state, input=Vector2.zero,
  next=1, elapsed=0, countdown=Config.ThrowDelay, lastInput=now, lastPacket=0, notify=0}
 send(player,"Countdown",{seconds=Config.ThrowDelay,yaw=yaw,pitch=pitch})
end
remote.OnServerEvent:Connect(function(player, action, x, y)
 if action == "Aim" then prepare(player)
 elseif action == "Launch" then launch(player,x,y)
 elseif action == "Reset" then
  if sessions[player] then stop(player,"Ready","Flight reset")
  else restore(player); send(player,"Ready",{message="Ready to aim"}) end
 elseif action == "Input" then
  local s = sessions[player]
  if not s or typeof(x)~="number" or typeof(y)~="number" then return end
  if x~=x or y~=y or math.abs(x)>1 or math.abs(y)>1 then return end
  local now=os.clock()
  if now-s.lastPacket < 1/30 then return end
  s.lastPacket=now; s.lastInput=now; s.input=Vector2.new(x,y)
 end
end)
local function register(player)
 player.CharacterRemoving:Connect(function()
  local s=sessions[player]
  if s then sessions[player]=nil; removeProjectile(player,s) end
  restore(player)
  send(player,"Ready",{message="Character reset"})
 end)
 player.CharacterAdded:Connect(function(character)
  character:WaitForChild("HumanoidRootPart")
  task.wait(0.1)
  if player.Character==character then character:PivotTo(CFrame.new(Config.ThrowStand)); restore(player) end
 end)
end
Players.PlayerAdded:Connect(register)
for _,p in Players:GetPlayers() do register(p) end
Players.PlayerRemoving:Connect(function(player)
 local s=sessions[player]
 if s then removeProjectile(player,s) end
 restore(player)
 sessions[player]=nil; cooldown[player]=nil; bests[player.UserId]=nil
end)
local accumulator=0
local step=1/60
RunService.Heartbeat:Connect(function(dt)
 accumulator += math.min(dt,0.25)
 while accumulator >= step do
  accumulator-=step
  for player,s in sessions do
   if s.countdown>0 then
    s.countdown-=step
    if s.countdown<=0 then send(player,"Flying",{next=1}) end
    continue
   end
   s.elapsed+=step
   if os.clock()-s.lastInput>0.5 then s.input=Vector2.zero end
   local old=s.state.position
   s.state=Flight.step(s.state,s.input,step)
   local new=s.state.position
   local hit=workspace:Raycast(old,new-old,s.raycast)
   if hit or new.Y<5 or math.abs(new.X)>650 or new.Z < -1000 or s.elapsed>Config.MaxDuration then
    stop(player,"Crashed","Flight ended 鈥?launch to try again")
    continue
   end
   s.model:PivotTo(Flight.frame(s.state,-s.input.X*0.35))
   -- The character remains visible on the deck throughout the projectile flight.
   local target=Config.Course[s.next]
   if Flight.crossed(old,new,target) then
    s.next+=1
    if s.next>#Config.Course then
     local best=bests[player.UserId]
     bests[player.UserId]=best and math.min(best,s.elapsed) or s.elapsed
     stop(player,"Finished","Course complete!")
     continue
    end
    send(player,"Checkpoint",{next=s.next,time=s.elapsed})
   elseif old.Z>=target.Z and new.Z<target.Z then
    stop(player,"Missed","Missed checkpoint "..s.next.." 鈥?try again")
    continue
   end
   s.notify+=step
   if s.notify>=0.1 then s.notify=0; send(player,"Telemetry",{time=s.elapsed,next=s.next,speed=Config.Speed*(1-0.22*math.sin(s.state.pitch))}) end
  end
 end
end)
print("Paper Flight server ready: server-authoritative flight, six swept checkpoints.")
]=])
